@startuml
' Configurações para otimização de espaço
skinparam Style strictuml
skinparam PackageStyle rectangle
skinparam shadowing false
skinparam Nodesep 35
skinparam Ranksep 40

title Diagrama de Classes — PageSimulator (Métodos Principais)

' Pacote de Algoritmos - Foco na Lógica de Substituição
package "algoritmos" {
    interface AlgoritmoSubstituicao <<interface>> {
        +int escolherFrameParaSubstituir(Frame[] frames)
        +void registrarEntrada(int frameIndex)
        +void registrarAcesso(int frameIndex)
    }
    class FIFO implements AlgoritmoSubstituicao
    class LRU implements AlgoritmoSubstituicao
    class LFU implements AlgoritmoSubstituicao
}

' Pacote de Memória - Foco na estrutura de dados
package "memoria" {
    class Frame {
        -Pagina pagina
        +boolean estaVazio()
    }
    class Pagina {
        -int numero
        -String conteudo
    }
}

' Pacote de Arquivos - Foco no IO
package "arquivos" {
    interface PageStore <<interface>> {
        +List<Pagina> generatePages(Path dir, int qtd)
        +Pagina loadPage(Path dir, int idx)
    }
    class FilePageStore implements PageStore
}

' Pacote de Simulação - O "Cérebro" do projeto
package "simulacao" {
    class ConfiguracaoSimulacao {
        +String algoritmo_selecionado
        +int numero_frames
    }
    class Simulacao {
        +void executarSimulacao()
    }
    class SimulacaoAlgoritmos {
        +void escolherAlgoritmo(List<Pagina> paginas)
        +void simularFIFO(List<Pagina> paginas, int frames)
        +void simularLRU(List<Pagina> paginas, int frames)
        +void simularLFU(List<Pagina> paginas, int frames)
    }
}

' Pacote UI e Main - Entrada e Saída
package "ui" {
    class Terminal {
        +void showResults(String alg, String seq, int falhas)
        +void showError(String error)
    }
}

package "main" {
    class PageSimulator {
        +{static} void main(String[] args)
    }
    class PageSimuladorOperacoes {
        +PageSimuladorOperacoes(Terminal ui, String[] args)
    }
}

' --- ORGANIZAÇÃO DAS RELAÇÕES (LAYOUT VERTICAL) ---

' Fluxo Principal
PageSimulator -down-> PageSimuladorOperacoes
PageSimuladorOperacoes -down-> ConfiguracaoSimulacao
Simulacao o-down- ConfiguracaoSimulacao
Simulacao -down-> SimulacaoAlgoritmos
Simulacao -right-> FilePageStore

' Interações de Simulação
SimulacaoAlgoritmos -down-> AlgoritmoSubstituicao : utiliza
SimulacaoAlgoritmos -left-> Terminal : reporta
SimulacaoAlgoritmos ..> Frame : gerencia

' Estrutura
Frame *-right- Pagina

' Ajuste de visibilidade: esconde membros repetitivos
hide FIFO members
hide LRU members
hide LFU members
hide PageStore members
hide Terminal members

@enduml